#!name=NodeLoc 每日签到
#!desc=NodeLoc 每日自动签到。开启 Cookie 抓取后，在浏览器登录 www.nodeloc.com 并刷新；保存成功后将抓取开关设为 false。需配套支持 ENABLE_CAPTURE 参数的 cookie.js。
#!arguments=签到执行时间:0 8 * * *,开启Cookie抓取:true
#!arguments-desc=签到执行时间：默认每天 08:00 执行，格式为 cron 表达式。\n\n开启Cookie抓取：\ntrue：允许保存浏览器请求中的登录 Cookie 和 User-Agent。\nfalse：停止抓取，已保存的 Cookie 和定时签到继续使用。\n\n首次使用请开启抓取，在浏览器登录 NodeLoc 并刷新。收到 Cookie 已保存通知后可将此参数改为 false。Cookie 失效时重新开启并登录刷新。\n\n请将配套 cookie.js 上传至脚本地址，旧脚本不支持此开关。修改执行时间请使用五字段 cron，例如 0 8 * * *。

[Script]
NodeLoc Cookie = type=http-request,pattern=^https://www\.nodeloc\.com/,requires-body=false,script-path=https://raw.githubusercontent.com/jiuyueqingcheng/qiandao/refs/heads/main/nodeloc/nodelocCookie.js,argument="{\"ENABLE_CAPTURE\":{{{开启Cookie抓取}}}}"
NodeLoc签到 = type=cron,cronexp="{{{签到执行时间}}}",timeout=60,script-path=https://raw.githubusercontent.com/jiuyueqingcheng/qiandao/refs/heads/main/nodeloc/qiandao.js

[MITM]
hostname = %APPEND% www.nodeloc.com
