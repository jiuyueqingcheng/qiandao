#!name=NodeLoc Cookie 抓取开关
#!desc=需要更新Cookie时开启，收到保存通知后可关闭，不影响定时签到
[MITM]
hostname = %APPEND% www.nodeloc.com

[Script]
NodeLoc Cookie = type=http-request,pattern=^https://www\.nodeloc\.com/,requires-body=false,script-path=https://raw.githubusercontent.com/jiuyueqingcheng/qiandao/refs/heads/main/nodeloc/cookie.js
